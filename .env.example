# Okvorado — configuration. Copier en `.env` et ajuster.
# Toutes les variables sont préfixées OKVORADO_.

# Hôte Akvorado. En dev depuis une station (via tunnels SSH), une seule valeur
# suffit : elle sert de défaut à tous les services.
OKVORADO_AKVORADO_HOST=192.0.2.6

# En déploiement CONTENEURISÉ sur le réseau docker `akvorado_default`, chaque
# service a son propre nom DNS — on les précise séparément (résolution par NOM,
# jamais par IP : les IP du bridge changent à chaque recréation) :
#   OKVORADO_AKVORADO_HOST=akvorado-outlet
#   OKVORADO_CLICKHOUSE_HOST=clickhouse
#   OKVORADO_CONSOLE_HOST=akvorado-console
# Laisser vide = utilise OKVORADO_AKVORADO_HOST.
OKVORADO_CLICKHOUSE_HOST=
OKVORADO_CONSOLE_HOST=

# Ports des services Akvorado (défauts du stack upstream)
OKVORADO_CLICKHOUSE_PORT=8123
OKVORADO_OUTLET_PORT=8080
OKVORADO_CONSOLE_PORT=8082

# Accès ClickHouse (lecture seule en v1)
OKVORADO_CLICKHOUSE_USER=default
OKVORADO_CLICKHOUSE_PASSWORD=
OKVORADO_CLICKHOUSE_DATABASE=default

# Chemin des métriques Prometheus de l'outlet.
# ATTENTION : `/metrics` renvoie 404 — le bon chemin est celui-ci (mesuré 2026-08-05).
OKVORADO_OUTLET_METRICS_PATH=/api/v0/outlet/metrics

# Config Akvorado montée en lecture seule dans le container Okvorado
OKVORADO_AKVORADO_CONFIG_PATH=/etc/akvorado-config/outlet.yaml

# Base locale (drafts, table port->application, audit)
OKVORADO_SQLITE_PATH=./data/okvorado.db

# Seuil au-delà duquel un exportateur déclaré sans flux est dit "silencieux"
OKVORADO_SILENT_THRESHOLD_HOURS=1

OKVORADO_HTTP_TIMEOUT_SECONDS=10

# --- Inventaire équipement SNMP (MIB-II système, écran /inventory) ---------
# Communauté SNMPv2c utilisée pour interroger sysName/sysDescr/sysLocation/
# sysContact/sysUpTime sur chaque exportateur connu. Vide = collecte
# désactivée (fail-safe). Secret : ne JAMAIS versionner une vraie valeur ici,
# ce fichier documente uniquement les clés attendues.
OKVORADO_SNMP_COMMUNITY=

# Délai avant de considérer un agent SNMP muet (état "no_response").
OKVORADO_SNMP_TIMEOUT_SECONDS=3

# Période de la collecte automatique en tâche de fond, en secondes.
OKVORADO_SNMP_POLL_INTERVAL_SECONDS=300

# Motifs d'interfaces SANS VALEUR NetFlow, exclues par défaut de la
# résolution SNMP (lo, docker0, bridges/veth Docker locaux à la machine).
# CSV, motif exact ("lo") ou préfixe wildcard ("br-*", "veth*"). Une
# interface DÉJÀ déclarée manuellement n'est jamais écartée, quel que soit
# le motif. Ajuster à la cible réelle (Palo Alto, routeurs SFR : les noms
# d'interfaces virtuelles diffèrent d'un Linux) une fois les noms observés.
OKVORADO_INTERFACE_EXCLUDE_PATTERNS=lo,docker0,br-*,veth*

# --- Catalogue applicatif (écran /app-catalog) ------------------------------
# URL du CSV IANA officiel (registre port -> nom de service). Défaut = source
# publique IANA. À surcharger UNIQUEMENT si un proxy d'entreprise (cas SFR
# probable) impose un miroir interne ; sinon laisser vide pour le défaut.
OKVORADO_IANA_CSV_URL=

# --- Agent de restart d'Akvorado (v2, écriture) -----------------------------
# Okvorado ne monte JAMAIS /var/run/docker.sock : ce serait root sur l'hôte pour
# une app web exposée à des utilisateurs. Un agent SÉPARÉ le monte et n'expose
# qu'une capacité — redémarrer les services Akvorado d'une allowlist — sur token.
#
# Résolution par NOM DNS sur le réseau docker akvorado_default, jamais par IP
# (les IP du bridge changent à chaque recréation de container).
OKVORADO_RESTART_AGENT_HOST=okvorado-restart-agent
OKVORADO_RESTART_AGENT_PORT=8098

# Token partagé avec l'agent (sa variable RESTART_AGENT_TOKEN doit être IDENTIQUE).
# Générer avec : openssl rand -hex 32
# Vide = fonction de restart désactivée (fail-safe : pas de restart silencieux).
OKVORADO_RESTART_AGENT_TOKEN=

# Un restart + attente du retour `healthy` prend 60 à 120 s : le timeout HTTP
# par défaut (10 s) serait bien trop court.
OKVORADO_RESTART_TIMEOUT_SECONDS=180

# --- Santé DB ClickHouse (écran /db-health) ---------------------------------
# Période de la collecte automatique de santé DB en tâche de fond, en secondes.
OKVORADO_DB_HEALTH_POLL_INTERVAL_SECONDS=300

# Âge maximal des lignes conservées dans l'historique de santé DB (jours).
OKVORADO_DB_HEALTH_HISTORY_MAX_AGE_DAYS=30

# Limite mémoire (octets) du conteneur ClickHouse, pour le calcul du % utilisé.
# Défaut = 2 Gio, mesuré sur le déploiement de référence (.6). Ajuster si le
# conteneur ClickHouse est dimensionné différemment (docker inspect <container>
# --format '{{.HostConfig.Memory}}').
OKVORADO_DB_HEALTH_MEMORY_LIMIT_BYTES=2147483648

# --- Préfixe d'URL (déploiement derrière le proxy Grafana) ------------------
# Grafana peut proxifier Okvorado via une datasource de plugin : l'URL servie
# devient /api/datasources/proxy/uid/<uid>/exporters au lieu de /exporters.
# Vide (défaut) = comportement actuel inchangé, aucun préfixe.
# Ne JAMAIS terminer par / (concaténation directe avec un chemin qui commence
# toujours par /, un / final produirait un double slash).
OKVORADO_URL_PREFIX=

# --- Authentification autonome (LOT auth) -----------------------------------
# Okvorado ne dépend d'AUCUNE brique d'authentification externe (pas
# d'Authelia, pas de SSO) : un compte admin local, protégé par mot de passe
# haché (PBKDF2-HMAC-SHA256) + TOTP optionnel.

# Identifiant de l'admin initial. Défaut : admin.
OKVORADO_AUTH_USER=admin

# Mot de passe en clair de l'admin initial — lu UNE FOIS au démarrage puis
# haché, jamais réécrit en clair nulle part (ni en base, ni en log).
#
# VIDE = un mot de passe ALÉATOIRE est généré et affiché UNE SEULE FOIS dans
# les logs du conteneur au premier démarrage (`docker logs okvorado`). Ce
# n'est PAS un défaut faible type "admin" : ce compte protège des routes qui
# redémarrent des conteneurs et purgent ClickHouse. Fixez cette variable pour
# choisir votre propre mot de passe dès le premier déploiement — sinon,
# récupérez le mot de passe généré dans les logs et changez-le depuis l'écran
# Sécurité (un bandeau d'avertissement reste affiché tant que ce n'est pas fait).
OKVORADO_AUTH_PASSWORD=

# Clé de signature des cookies de session. Générer avec : openssl rand -hex 32
# Vide = génération aléatoire au démarrage — les sessions ouvertes ne
# survivent alors PAS à un redémarrage du conteneur (tout le monde doit se
# reconnecter). Fixez cette variable pour des sessions stables entre redéploiements.
OKVORADO_AUTH_SESSION_SECRET=

# Durée de vie d'une session, en secondes. Défaut 12h (43200).
OKVORADO_AUTH_SESSION_MAX_AGE_SECONDS=43200

# Cookie de session marqué `Secure` (envoyé uniquement en HTTPS). Défaut
# `false` car le stack tourne en HTTP nu par défaut — un cookie `Secure` ne
# serait alors JAMAIS envoyé par le navigateur, cassant l'authentification en
# silence. Passer à `true` dès que l'app est servie derrière TLS.
OKVORADO_AUTH_COOKIE_SECURE=false

# Limitation de tentatives sur /login (fenêtre glissante en mémoire).
OKVORADO_AUTH_LOGIN_MAX_ATTEMPTS=5
OKVORADO_AUTH_LOGIN_WINDOW_SECONDS=300
